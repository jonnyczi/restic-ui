# Go build output
/restic-ui
/bin/
/dist/

# Runtime data / local SQLite
/data/
/config/
*.db
*.db-shm
*.db-wal

# Node
web/node_modules/
web/tsconfig.tsbuildinfo

# E2E suite
e2e/node_modules/
e2e/.testenv/
e2e/test-results/
e2e/playwright-report/

# README screenshot pipeline intermediates (committed output: docs/screenshots/)
e2e/screenshots/raw/
e2e/screenshots/test-results/

# Built frontend assets are generated (Docker build / `pnpm build`).
# Keep only the placeholder index.html so `go build` works on a fresh checkout.
web/dist/*
!web/dist/index.html

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
